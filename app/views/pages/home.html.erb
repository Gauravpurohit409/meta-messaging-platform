<% content_for :title, "Marquee — WhatsApp templates and campaigns" %>
<% content_for :unframed, "true" %>

<div class="min-h-screen">
  <header class="mx-auto flex max-w-6xl items-center justify-between px-5 py-6">
    <p class="font-serif text-3xl text-[#14241c]">Marquee</p>
    <div class="flex items-center gap-2">
      <%= link_to "Sign in", new_user_session_path, class: btn_secondary %>
      <%= link_to "Open a desk", new_user_registration_path, class: btn_primary %>
    </div>
  </header>

  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-6 lg:grid-cols-[minmax(0,1.15fr)_320px] lg:pt-10">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[#1f7a45]">WhatsApp Business desk</p>
      <h1 class="mt-4 max-w-xl font-serif text-5xl leading-[1.02] tracking-tight text-[#14241c] sm:text-6xl">Get the template approved. Then send the campaign.</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#3d3832]">Marquee is where a business drafts a WhatsApp template, submits it to Meta, and — once it is approved — sends it to customers who opted in.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to "Start with a template", new_user_registration_path, class: btn_primary %>
        <%= link_to "Use the demo desk", new_user_session_path, class: btn_secondary %>
      </div>
      <p class="mt-4 text-sm text-[#6d645b]">Demo desk: demo@marquee.test · password123</p>
    </div>

    <%= render "shared/phone",
          caption: "order_ready · approved",
          header: "Northwind Grocery",
          body: "Hi Asha, order NW-1042 is packed and waiting at the Ballygunge counter.",
          footer: "Reply here if you need a later slot.",
          buttons: ["Track order"] %>
  </section>

  <section class="border-t border-[#e4dccf] bg-[#fbf8f3]">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-14 md:grid-cols-3">
      <article>
        <p class="font-serif text-3xl text-[#1f7a45]">01</p>
        <h2 class="mt-3 text-lg font-medium">Write the template</h2>
        <p class="mt-2 text-sm leading-relaxed text-[#5c564e]">Header, body, footer, and up to three buttons. Variables look like {{1}}. Meta will not approve a message that starts or ends with one.</p>
      </article>
      <article>
        <p class="font-serif text-3xl text-[#1f7a45]">02</p>
        <h2 class="mt-3 text-lg font-medium">Wait for Meta</h2>
        <p class="mt-2 text-sm leading-relaxed text-[#5c564e]">Marketing, utility, and authentication templates are reviewed. Marquee listens for the status webhook and moves the card when Meta decides.</p>
      </article>
      <article>
        <p class="font-serif text-3xl text-[#1f7a45]">03</p>
        <h2 class="mt-3 text-lg font-medium">Launch the campaign</h2>
        <p class="mt-2 text-sm leading-relaxed text-[#5c564e]">Pick an approved template, paste numbers or a CSV, and Sidekiq sends them through the Cloud API under the throughput limit.</p>
      </article>
    </div>
  </section>

  <footer class="mx-auto max-w-6xl px-5 py-8 text-sm text-[#6d645b]">
    Meta reviews every template and bills each delivered message. Marquee does not send anything to people who are not on the list you upload.
  </footer>
</div>
