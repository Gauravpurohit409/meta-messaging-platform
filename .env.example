# Optional. Demo mode needs none of these.
# Production must set the encryption keys or saved WhatsApp tokens cannot be read.

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Live Meta calls. Leave blank to stay in demo mode.
META_GRAPH_VERSION=v26.0
META_APP_SECRET=
META_VERIFY_TOKEN=

# Meta app identity for Embedded Signup. The display name cannot contain
# Meta, WhatsApp or Facebook as a word.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_DISPLAY_NAME=

SUPPORT_EMAIL=support@example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RETENTION_WEBHOOK_DAYS=30
RETENTION_RECIPIENT_DAYS=180

REDIS_URL=redis://localhost:6379/0
REDIS_URL_CABLE=redis://localhost:6379/1
DATABASE_URL=
