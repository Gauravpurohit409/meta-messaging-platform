<% header ||= nil %>
<% footer ||= nil %>
<% buttons ||= [] %>
<% caption ||= "Template preview" %>
<div class="mx-auto w-full max-w-[300px] rounded-[2rem] border border-[#d9d1c3] bg-[#1c1915] p-2 shadow-[0_20px_50px_rgba(20,36,28,0.18)]">
  <div class="overflow-hidden rounded-[1.55rem] bg-[#efeae2]">
    <div class="flex items-center gap-2 bg-[#075e54] px-3 py-3 text-white">
      <span class="grid h-8 w-8 place-items-center rounded-full bg-white/15 text-xs font-medium">M</span>
      <div>
        <p class="text-sm font-medium leading-none">WhatsApp</p>
        <p class="mt-1 text-[10px] text-white/75"><%= caption %></p>
      </div>
    </div>
    <div class="min-h-[300px] bg-[#efeae2] px-3 py-4" style="background-image: radial-gradient(circle at 12% 20%, rgba(255,255,255,.7), transparent 28%), radial-gradient(circle at 80% 0%, rgba(255,255,255,.45), transparent 24%);">
      <div class="max-w-[92%] rounded-lg rounded-tl-none bg-white px-3 py-2 text-[13px] leading-snug text-[#1c1915] shadow-sm">
        <% if header.present? %>
          <p class="mb-1 font-semibold"><%= header %></p>
        <% end %>
        <div class="whitespace-pre-wrap"><%= body %></div>
        <% if footer.present? %>
          <p class="mt-2 text-[11px] text-[#6d645b]"><%= footer %></p>
        <% end %>
        <% buttons.each do |label| %>
          <div class="mt-1 border-t border-[#eee6da] py-2 text-center text-[13px] font-medium text-[#1a6b8a]"><%= label %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
