<% content_for :title, "Campaigns — Marquee" %>
<% content_for :heading, "Campaigns" %>
<% content_for :subheading, "Each campaign sends one approved template to a list of people who opted in." %>
<% content_for :actions do %>
  <%= link_to "New campaign", new_campaign_path, class: btn_primary %>
<% end %>

<% if @campaigns.any? %>
  <div class="space-y-3">
    <% @campaigns.each do |campaign| %>
      <%= link_to campaign, class: "block rounded-3xl bg-white px-5 py-4 ring-1 ring-[#e4dccf] transition hover:-translate-y-0.5" do %>
        <span class="flex items-start justify-between gap-3">
          <span>
            <span class="block font-medium"><%= campaign.name %></span>
            <span class="mt-1 block text-sm text-[#6d645b]"><%= campaign.template.name %> · <%= pluralize(campaign.total_recipients, "person") %> · <%= campaign.delivered_count %> delivered</span>
          </span>
          <%= status_pill(campaign.status) %>
        </span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-3xl bg-white px-6 py-12 text-center ring-1 ring-[#e4dccf]">
    <h2 class="font-serif text-3xl">No campaigns yet</h2>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-[#5c564e]">You need an approved template before a campaign can go out. Draft one, submit it, and come back when the status says approved.</p>
    <%= link_to "See templates", templates_path, class: "#{btn_primary} mt-6" %>
  </div>
<% end %>
