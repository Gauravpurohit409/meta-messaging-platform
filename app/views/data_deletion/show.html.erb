<% content_for :title, "Data deletion — #{app_name}" %>
<% content_for :unframed, "true" %>

<div class="mx-auto max-w-3xl px-5 py-12">
  <h1 class="font-serif text-4xl">Data deletion</h1>
  <p class="mt-6 text-sm leading-relaxed text-[#3d3832]">Request <%= @request.confirmation_code %> is complete. <%= app_name %> does not store a Facebook profile. This desk sends approved WhatsApp templates; it is not a support inbox. To delete the business data held here, delete the account from Account settings or email <%= app_support_email %>.</p>
</div>
