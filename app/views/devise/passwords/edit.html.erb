<% content_for :title, "Choose a password — Marquee" %>
<% content_for :unframed, "true" %>

<%= render layout: "shared/auth_frame", locals: { title: "Choose a new password", lede: "Use it the next time you sign in." } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <%= f.label :password, "New password", class: label_class %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: field_class %>
    <%= f.label :password_confirmation, "Confirm new password", class: "#{label_class} mt-4" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: field_class %>
    <%= f.submit "Update password", class: "#{btn_primary} mt-4 w-full" %>
  <% end %>
<% end %>
