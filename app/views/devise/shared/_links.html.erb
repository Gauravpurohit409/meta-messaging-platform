<div class="space-y-2">
  <% if controller_name != "sessions" %>
    <p><%= link_to "Sign in", new_session_path(resource_name), class: "font-medium text-[#1f7a45]" %></p>
  <% end %>
  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <p><%= link_to "Open a desk", new_registration_path(resource_name), class: "font-medium text-[#1f7a45]" %></p>
  <% end %>
  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-[#5c564e]" %></p>
  <% end %>
</div>
